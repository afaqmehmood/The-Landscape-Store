{%- comment -%}
  Parameters:
  - rating_value {Number} - Rating value.
  - rating_count {Number} - Number of ratings (optional).

  Usage:
  {% render 'rating',
    rating_value: product.metafields.reviews.rating.value,
    rating_count: product.metafields.reviews.rating_count
  %}
{%- endcomment -%}

{%- liquid
  assign decimal = rating_value | modulo: 1
  assign stars_rating = rating_value | floor
  assign rating_count = rating_count | plus: 0

  if decimal >= 0.3 and decimal <= 0.7
    assign stars_rating = stars_rating | plus: 0.5
  elsif decimal > 0.7
    assign stars_rating = rating_value | ceil
  endif
-%}
{% if stars_rating != blank %}
<div class="rating inline-flex items-center" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating_value, rating_max: 5 }}">
  <div class="rating__stars" aria-hidden="true" style="--rating: {{ stars_rating }}; --rating-max: 5;">★★★★★ {% if rating_count != blank -%}</div>
  <div class="rating__count inline-block align-middle text-sm">({{ rating_count }} {% if rating_count > 1 %}Reviews{% else %}Review{% endif %}){%- endif %}</div>
</div>
{% endif %}
